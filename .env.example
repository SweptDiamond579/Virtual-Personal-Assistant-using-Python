# JARVIS OS configuration. Copy to `.env` (repo root or apps/api/) and fill in.
# Never commit real values. Everything here is read only by the API server.

# --- core -------------------------------------------------------------------
JARVIS_ENV=development                      # development | test | production
DATABASE_URL=postgresql+asyncpg://jarvis:jarvis-dev-password@127.0.0.1:5432/jarvis
# Master secret (required in production): derives the key that encrypts stored credentials.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JARVIS_SECRET_KEY=
# One-time token needed to create the owner account on first run. Remove after setup.
JARVIS_SETUP_TOKEN=
JARVIS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
JARVIS_COOKIE_SECURE=false                  # true behind HTTPS
JARVIS_SESSION_TTL_HOURS=168

# --- AI provider --------------------------------------------------------------
# Leave JARVIS_AI_PROVIDER empty to auto-detect from the keys below.
JARVIS_AI_PROVIDER=                         # anthropic | openai_compatible | scripted (test double) | none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5       # used for short, simple requests when routing is auto
ANTHROPIC_EFFORT=medium                     # low | medium | high | xhigh | max
ANTHROPIC_REFUSAL_FALLBACK=true             # server-side refusal fallback (fallbacks: "default")
JARVIS_MODEL_ROUTING=auto                   # auto | fixed
# Any OpenAI-compatible server (Ollama, LM Studio, vLLM, OpenRouter, OpenAI…)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- budgets & limits ---------------------------------------------------------
JARVIS_DAILY_BUDGET_USD=5
JARVIS_MAX_STEPS_PER_RUN=8
JARVIS_MAX_OUTPUT_TOKENS=16000
JARVIS_APPROVAL_TIMEOUT_S=600

# --- voice --------------------------------------------------------------------
JARVIS_STT_ENGINE=pocketsphinx              # pocketsphinx (offline) | openai_compatible | none
JARVIS_TTS_ENGINE=espeak                    # espeak (offline, needs espeak-ng) | openai_compatible | none
OPENAI_COMPAT_STT_MODEL=whisper-1
OPENAI_COMPAT_TTS_MODEL=tts-1
OPENAI_COMPAT_TTS_VOICE=alloy

# --- integrations ---------------------------------------------------------------
GITHUB_API_URL=https://api.github.com       # GitHub tokens are added in the UI (stored encrypted)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- automation & browser -------------------------------------------------------
JARVIS_SCHEDULER_ENABLED=true
JARVIS_BROWSER_ENABLED=true
