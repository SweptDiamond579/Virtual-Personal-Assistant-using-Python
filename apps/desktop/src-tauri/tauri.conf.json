{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS OS",
  "version": "0.1.0",
  "identifier": "os.jarvis.desktop",
  "build": {
    "frontendDist": "../fallback"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true,
      "capabilities": ["main-window-remote"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "JARVIS OS desktop companion",
    "longDescription": "Desktop companion for JARVIS OS. Loads the JARVIS web UI and performs a small set of locally allow-listed native actions, enforced by a local policy file.",
    "copyright": "JARVIS OS contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
